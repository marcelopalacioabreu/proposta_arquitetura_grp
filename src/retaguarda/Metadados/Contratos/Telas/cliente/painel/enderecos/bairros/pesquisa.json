        { "tipo": "confirmacao_delete_ajax", "destino": "/api/bairros/{id}", "campo_id": "id", "icone": "trash", "permissao": "enderecos.bairros.excluir", "exibirQuandoAtivo": true }
      ],
      "pagination": { "pageSize": 10 }
    }
