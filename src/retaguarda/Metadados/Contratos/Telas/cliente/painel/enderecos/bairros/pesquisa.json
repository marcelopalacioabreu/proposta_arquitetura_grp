      { "tipo": "navegacao", "destino": "/painel/enderecos/bairros/editar/new", "campo_id": "id", "icone": "bi-plus", "permissao": "enderecos.bairros.editar" }
    ],
    "itens": [
      { "campo": "nome", "label": "Nome", "tipo": "text", "col": 6 },
