      { "tipo": "navegacao", "destino": "/painel/enderecos/editar/new", "campo_id": "id", "icone": "bi-plus", "permissao": "enderecos.criar" }
    ],
    "itens": [
      { "campo": "logradouro", "label": "Logradouro", "tipo": "text", "col": 6 },
      { "campo": "numero", "label": "Número", "tipo": "text", "col": 2 },
      { "campo": "bairroNome", "label": "Bairro", "tipo": "text", "col": 4 }
    ],
    "filtro": [
      { "campo": "logradouro", "descricao": "Logradouro", "tipo": "string" },
      { "campo": "bairro", "descricao": "Bairro", "tipo": "string" }
    ],
    "tabela": {
      "colunas": [
        { "campo": "logradouro", "titulo": "Logradouro" },
        { "campo": "numero", "titulo": "Número" },
        { "campo": "bairroNome", "titulo": "Bairro" }
      ],
      "acoes": [
        { "tipo": "navegacao", "destino": "/painel/enderecos/editar/{id}", "icone": "pencil", "permissao": "enderecos.editar" },
        { "tipo": "confirmacao_delete_ajax", "destino": "/api/enderecos/{id}", "campo_id": "id", "icone": "trash", "permissao": "enderecos.deletar", "exibirQuandoAtivo": true }
      ],
      "pagination": { "pageSize": 10 }
    }
  }
