{
  "organizacaoPesquisa": {
    "tipo": "TELA_PESQUISA",
    "titulo": "Organizações",
    "extremidade": "/api/organizacoes",
    "acoesFormulario": [
      {
        "tipo": "navegacao",
        "destino": "/painel/organizacoes/editar/new",
        "campo_id": "id",
        "icone": "bi-plus",
        "permissao": "organizacoes.editar"
      }
    ],
    "filtro": [
      {
        "campo": "codigo",
        "descricao": "Código",
        "tipo": "string",
        "col": 3
      },
      {
        "campo": "nome",
        "descricao": "Nome",
        "tipo": "string",
        "col": 3
      },
      {
        "campo": "created_at",
        "descricao": "Criado em",
        "tipo": "date",
        "col": 3
      }
    ],
    "tabela": {
      "colunas": [
        {
          "campo": "codigo",
          "titulo": "Código",
          "visivelTelaPequena": false
        },
        {
          "campo": "nome",
          "titulo": "Nome",
          "visivelTelaPequena": true
        },
        {
          "campo": "dataInsercao",
          "titulo": "Criado em",
          "visivelTelaPequena": false
        }
      ],
      "campos": [
        "codigo",
        "nome",
        "descricao",
        "created_at"
      ],
      "acoes": [
        {
          "tipo": "navegacao",
          "destino": "/painel/organizacoes/editar/{id}",
          "campo_id": "id",
          "icone": "pencil",
          "permissao": "organizacoes.editar"
        },
        {
          "tipo": "navegacao",
          "destino": "/painel/organizacoes/{id}/unidades",
          "campo_id": "id",
          "icone": "grid-3x3-gap",
          "permissao": "organizacoes.unidades.visualizar"
        },
        {
          "tipo": "confirmacao_delete_ajax",
          "destino": "/api/organizacoes/{id}",
          "campo_id": "id",
          "icone": "trash",
          "permissao": "organizacoes.excluir",
          "exibirQuandoAtivo": true
        },
        {
          "tipo": "confirmacao_post_ajax",
          "destino": "/api/organizacoes/{id}/restaurar",
          "campo_id": "id",
          "icone": "arrow-counterclockwise",
          "permissao": "organizacoes.editar",
          "exibirQuandoInativo": true,
          "mensagem": "Restaurar registro?"
        }
      ]
    },
    "pagination": {
      "pageSize": 10
    }
  }
}