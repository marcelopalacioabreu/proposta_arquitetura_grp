{
  "organizacaoUnidadeCadastro": {
    "tipo": "TELA_CADASTRO",
    "titulo": "Cadastro de Unidade",
    "extremidade": "/api/organizacao_unidades",
    "camposChaveUrl": ["organizacaoId"],
    "urlTela": "organizacoes/{organizacaoId}/unidades",
    "itens": [
      { "campo": "codigo", "label": "Código", "tipo": "text", "col": 3 },
      { "campo": "sigla", "label": "Sigla", "tipo": "text", "col": 3 },
      { "campo": "cnpj", "label": "CNPJ", "tipo": "text", "col": 6 },

      {
        "titulo": "Identificação",
        "columns": 12,
        "campos": [
          { "campo": "nome", "label": "Nome da Unidade", "tipo": "text", "col": 6 },
          { "campo": "organizacaoId", "label": "Organização", "tipo": "hidden", "col": 6 },
          { "campo": "unidadePaiId", "label": "Unidade Pai", "tipo": "select", "url": "/api/organizacao_unidades", "col": 6 }
        ]
      },

      {
        "titulo": "Classificação",
        "columns": 12,
        "campos": [
          { "campo": "tipoUnidadeId", "label": "Tipo de Unidade", "tipo": "select", "url": "/api/tiposunidade", "col": 4 },
          { "campo": "situacaoId", "label": "Situação", "tipo": "select", "url": "/api/situacoes", "col": 4 },
          { "campo": "responsavelPessoaId", "label": "Responsável (Pessoa)", "tipo": "select", "url": "/api/pessoas", "col": 4 }
        ]
      },

      {
        "titulo": "Hierarquia e Validade",
        "columns": 12,
        "campos": [
          { "campo": "dataFundacao", "label": "Data de Fundação", "tipo": "date", "col": 4 },
          { "campo": "dataExtincao", "label": "Data de Extinção", "tipo": "date", "col": 4 },
          { "campo": "validoDe", "label": "Válido De", "tipo": "date", "col": 4 },
          { "campo": "validoAte", "label": "Válido Até", "tipo": "date", "col": 4 },
          { "campo": "hierarquiaCodigo", "label": "Código de Hierarquia", "tipo": "text", "col": 12 },
          { "campo": "hierarquiaNome", "label": "Nome de Hierarquia", "tipo": "text", "col": 12 },
          { "campo": "nivel", "label": "Nível", "tipo": "number", "col": 3 }
        ]
      },

      {
        "titulo": "Detalhes",
        "columns": 12,
        "campos": [
          { "campo": "descricao", "label": "Descrição", "tipo": "text", "col": 12 }
        ]
      }
    ]
  }
}
