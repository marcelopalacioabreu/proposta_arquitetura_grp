{
  "organizacaoUnidadePesquisa": {
    "tipo": "TELA_PESQUISA",
    "titulo": "Unidades",
    "extremidade": "/api/organizacao_unidades",
    "camposChaveUrl": ["organizacaoId"] ,
    "urlTela": "organizacoes/{organizacaoId}/unidades",
    "filtro": [
      { "campo": "codigo", "descricao": "Código", "tipo": "string", "col": 3 },
      { "campo": "nome", "descricao": "Nome", "tipo": "string", "col": 3 },
      { "campo": "created_at", "descricao": "Criado em", "tipo": "date", "col": 3 },
      { "campo": "ativo", "descricao": "Ativo", "tipo": "boolean", "col": 3 }
    ],
    "tabela": {
      "colunas": [
        { "campo": "codigo", "titulo": "Código", "visivelTelaPequena": false },
        { "campo": "nome", "titulo": "Nome", "visivelTelaPequena": true },
        { "campo": "organizacaoId", "titulo": "Organização", "visivelTelaPequena": false },
        { "campo": "created_at", "titulo": "Criado em", "visivelTelaPequena": false }
      ],
      "campos": ["codigo", "nome", "organizacaoId", "created_at"],
      "acoes": [
        { "tipo": "navegacao", "destino": "/painel/organizacoes/unidades/editar/{id}", "campo_id": "id", "icone": "pencil" },
        { "tipo": "navegacao", "destino": "/painel/organizacoes/unidades/setores/{id}", "campo_id": "id", "icone": "diagram-3" },
        { "tipo": "confirmacao_delete_ajax", "destino": "/api/organizacao_unidades/{id}", "campo_id": "id", "icone": "trash" },
        { "tipo": "confirmacao_post_ajax", "destino": "/api/organizacao_unidades/{id}/restaurar", "campo_id": "id", "icone": "arrow-counterclockwise", "exibirQuandoInativo": true, "mensagem": "Restaurar registro?" }
      ]
    },
    "pagination": { "pageSize": 10 }
  }
}
