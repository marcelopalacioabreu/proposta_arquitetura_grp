{
  "pessoaPesquisa": {
    "tipo": "TELA_PESQUISA",
    "titulo": "Pesquisa de Pessoas",
    "extremidade": "/api/pessoas",
    "acoesFormulario": [
      { "tipo": "navegacao", "destino": "/painel/pessoas/editar/new", "campo_id": "id", "icone": "bi-plus", "permissao": "pessoas.criar" }
    ],
    "itens": [
      { "campo": "nome", "label": "Nome", "tipo": "text", "col": 6 },
      { "campo": "documento", "label": "Documento", "tipo": "text", "col": 6 }
    ],
    "filtro": [
      { "campo": "nome", "descricao": "Nome", "tipo": "string" },
      { "campo": "documento", "descricao": "Documento", "tipo": "string" }
    ],
    "tabela": {
      "colunas": [
        { "campo": "nome", "titulo": "Nome" },
        { "campo": "documento", "titulo": "Documento" },
        { "campo": "telefone", "titulo": "Telefone" },
        { "campo": "email", "titulo": "E-mail" }
      ],
      "acoes": [
        { "tipo": "navegacao", "destino": "/painel/pessoas/editar/{id}", "icone": "pencil", "permissao": "pessoas.editar" },
        { "tipo": "confirmacao_delete_ajax", "destino": "/api/pessoas/{id}", "campo_id": "id", "icone": "trash", "permissao": "pessoas.deletar", "exibirQuandoAtivo": true },
        { "tipo": "confirmacao_post_ajax", "destino": "/api/pessoas/{id}/restaurar", "campo_id": "id", "icone": "arrow-counterclockwise", "permissao": "pessoas.restaurar", "exibirQuandoInativo": true, "mensagem": "Restaurar esta pessoa?" }
      ],
      "pagination": { "pageSize": 10 }
    }
  }
}
