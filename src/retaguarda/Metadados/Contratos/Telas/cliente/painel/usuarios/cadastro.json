    "itens": [
      { "campo": "nome", "label": "Nome", "tipo": "text", "col": 6 },
      { "campo": "username", "label": "Usuário (login)", "tipo": "text", "col": 6 },
      { "campo": "senhaHash", "label": "Senha (hash esperado)", "tipo": "password", "col": 6 },
      { "campo": "email", "label": "E-mail", "tipo": "text", "col": 6 },
      {
        "titulo": "Pessoa (aninhada)",
