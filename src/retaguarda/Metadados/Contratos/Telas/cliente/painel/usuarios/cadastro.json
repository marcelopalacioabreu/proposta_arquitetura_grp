        "campos": [
          { "campo": "pessoa.nome", "label": "Nome / Razão Social", "tipo": "text", "col": 8 },
          { "campo": "pessoa.tipoPessoaChave", "label": "Tipo", "tipo": "select", "enumeracao": "pessoa.tipos", "col": 4 },
          { "campo": "pessoa.documento", "label": "Documento", "tipo": "text", "col": 6 }
        ]
      },
      {
        "titulo": "Alocação",
        "columns": 12,
        "campos": [
          { "campo": "organizacaoId", "label": "Organização", "tipo": "select", "url": "/api/organizacoes", "col": 4 },
          { "campo": "organizacaoUnidadeId", "label": "Unidade", "tipo": "select", "url": "/api/organizacao_unidades", "col": 4 },
          { "campo": "perfilIds", "label": "Perfis (múltiplo)", "tipo": "multiselect", "url": "/api/perfis", "col": 4 }
        ]
      }
    ],
    "subcadastros": [
      {
        "nome": "atuacao",
        "titulo": "Atuação em Setores e Unidades",
