            "tipo": "select",
            "endpoint": "/api/setores",
            "col": 5
          },
          {
            "campo": "ehPadrao",
            "label": "Padrão",
            "tipo": "checkbox",
            "col": 2
          }
        ],
        "selecao": {
          "campo": "ehPadrao",
          "label": "Definir como padrão",
          "singleSelecao": true,
