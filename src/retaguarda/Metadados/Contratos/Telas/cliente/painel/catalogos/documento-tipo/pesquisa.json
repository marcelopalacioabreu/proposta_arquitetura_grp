{
  "documentoTipoPesquisa": {
    "titulo": "Pesquisa de Tipos de Documento",
    "extremidade": "/api/documentotipos",
    "acoesFormulario": [
      { "tipo": "navegacao", "destino": "/painel/catalogos/documento-tipo/editar/new", "campo_id": "id", "icone": "bi-plus", "permissao": "catalogos.documentoTipo.criar" }
    ],
    "filtro": [
      { "campo": "codigo", "descricao": "Código", "tipo": "string", "col": 3 },
      { "campo": "nome", "descricao": "Nome", "tipo": "string", "col": 6 }
    ],
    "tabela": {
      "colunas": [
        { "campo": "codigo", "titulo": "Código" },
        { "campo": "nome", "titulo": "Nome" }
      ],
      "acoes": [
        { "tipo": "navegacao", "destino": "/painel/catalogos/documento-tipo/editar/{id}", "campo_id": "id", "icone": "pencil", "permissao": "catalogos.documentoTipo.editar" },
        { "tipo": "confirmacao_delete_ajax", "destino": "/api/documentotipos/{id}", "campo_id": "id", "icone": "trash", "permissao": "catalogos.documentoTipo.deletar", "exibirQuandoAtivo": true }
      ],
      "pagination": { "pageSize": 10 }
    }
  }
}
