    ],    "filtro": [
      { "campo": "codigo", "descricao": "Código", "tipo": "string", "col": 3 },
      { "campo": "nome", "descricao": "Nome", "tipo": "string", "col": 6 }
    ],
    "tabela": {
      "colunas": [
        { "campo": "codigo", "titulo": "Código" },
        { "campo": "nome", "titulo": "Nome" }
      ],
      "acoes": [
        { "tipo": "navegacao", "destino": "/painel/catalogos/tipo-unidade/editar/{id}", "campo_id": "id", "icone": "pencil", "permissao": "catalogos.tipoUnidade.editar" },
        { "tipo": "confirmacao_delete_ajax", "destino": "/api/tipounidade/{id}", "campo_id": "id", "icone": "trash", "permissao": "catalogos.tipoUnidade.excluir", "exibirQuandoAtivo": true }
      ],
      "pagination": { "pageSize": 10 }
    }
  }
}


