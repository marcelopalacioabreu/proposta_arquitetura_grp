{
  "tipoImovelPesquisa": {
    "titulo": "Pesquisa de Tipos de Imóvel",
    "extremidade": "/api/tiposimovel",    "acoesFormulario": [
      { "tipo": "navegacao", "destino": "/painel/catalogos/tipo-imovel/editar/new", "campo_id": "id", "icone": "bi-plus", "permissao": "catalogos.tipoImovel.editar" }
    ],    "filtro": [
      { "campo": "codigo", "descricao": "Código", "tipo": "string", "col": 3 },
      { "campo": "nome", "descricao": "Nome", "tipo": "string", "col": 6 }
    ],
    "tabela": {
      "colunas": [
        { "campo": "codigo", "titulo": "Código" },
        { "campo": "nome", "titulo": "Nome" }
      ],
      "acoes": [
        { "tipo": "navegacao", "destino": "/painel/catalogos/tipo-imovel/editar/{id}", "campo_id": "id", "icone": "pencil", "permissao": "catalogos.tipoImovel.editar" },
        { "tipo": "confirmacao_delete_ajax", "destino": "/api/tipoimovel/{id}", "campo_id": "id", "icone": "trash", "permissao": "catalogos.tipoImovel.excluir", "exibirQuandoAtivo": true }
      ],
      "pagination": { "pageSize": 10 }
    }
  }
}


