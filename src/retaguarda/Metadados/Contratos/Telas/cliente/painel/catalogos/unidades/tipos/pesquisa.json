      { "campo": "nome", "descricao": "Nome", "tipo": "string", "col": 6 }
    ],
    "tabela": {
      "colunas": [
        { "campo": "codigo", "titulo": "Código" },
        { "campo": "nome", "titulo": "Nome" },
        { "campo": "descricao", "titulo": "Descrição" }
      ],
      "acoes": [
        { "tipo": "navegacao", "destino": "/painel/catalogos/unidades/tipos/editar/{id}", "campo_id": "id", "icone": "pencil", "permissao": "catalogos.unidades.tipos.editar" },
        { "tipo": "confirmacao_delete_ajax", "destino": "/api/tipos/{id}", "campo_id": "id", "icone": "trash", "permissao": "catalogos.unidades.tipos.excluir", "exibirQuandoAtivo": true }
      ],
      "pagination": { "pageSize": 10 }
    }
