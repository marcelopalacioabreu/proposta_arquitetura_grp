{
  "unidadesTiposPesquisa": {
    "titulo": "Pesquisa de tipos de unidade",
    "extremidade": "/api/tipos",
    "padraoURLInterface": "/painel/catalogos/unidades/tipos",
    "camposChaveUrl": [],
    "urlTela": "catalogos/unidades/tipos",
    "filtrosFixos": {
      "contexto": "UNIDADE_TIPO"
    },
    "acoesFormulario": [
      { "tipo": "navegacao", "destino": "/painel/catalogos/unidades/tipos/editar/new", "campo_id": "id", "icone": "bi-plus", "permissao": "catalogos.unidades.tipos.editar" }
    ],
    "filtro": [
