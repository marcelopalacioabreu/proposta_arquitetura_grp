{
  "perfilPesquisa": {
    "tipo": "TELA_PESQUISA",
    "titulo": "Pesquisa de Perfis",
    "extremidade": "/api/perfis",
    "acoesFormulario": [
      { "tipo": "navegacao", "destino": "/painel/perfis/editar/new", "campo_id": "id", "icone": "bi-plus", "permissao": "perfis.criar" }
    ],
    "itens": [
      { "campo": "nome", "label": "Nome", "tipo": "text", "col": 6 }
    ],
    "filtro": [
      { "campo": "nome", "descricao": "Nome", "tipo": "string" }
    ],
    "tabela": {
      "colunas": [
        { "campo": "nome", "titulo": "Nome" },
        { "campo": "administradorDoSistema", "titulo": "Administrador" }
      ],
      "acoes": [
        { "tipo": "navegacao", "destino": "/painel/perfis/editar/{id}", "icone": "pencil", "permissao": "perfis.editar" },
        { "tipo": "confirmacao_delete_ajax", "destino": "/api/perfis/{id}", "campo_id": "id", "icone": "trash", "permissao": "perfis.deletar", "exibirQuandoAtivo": true },
        { "tipo": "confirmacao_post_ajax", "destino": "/api/perfis/{id}/restaurar", "campo_id": "id", "icone": "arrow-counterclockwise", "permissao": "perfis.restaurar", "exibirQuandoInativo": true, "mensagem": "Restaurar este perfil?" }
      ],
      "pagination": { "pageSize": 10 }
    }
  }
}
