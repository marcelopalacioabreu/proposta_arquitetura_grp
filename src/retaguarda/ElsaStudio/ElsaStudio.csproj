<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.13" PrivateAssets="all" />
    <PackageReference Include="Elsa.Studio" Version="3.7.1" />
    <PackageReference Include="Elsa.Studio.Core.BlazorWasm" Version="3.7.1" />
    <PackageReference Include="Elsa.Studio.Authentication.ElsaIdentity.BlazorWasm" Version="3.7.1" />
    <PackageReference Include="Elsa.Studio.Authentication.ElsaIdentity.UI" Version="3.7.1" />
    <PackageReference Include="Elsa.Studio.Authentication.OpenIdConnect.BlazorWasm" Version="3.7.1" />
    <PackageReference Include="Elsa.Studio.Localization.BlazorWasm" Version="3.7.1" />
    <PackageReference Include="Elsa.Api.Client" Version="3.7.1" />
  </ItemGroup>

</Project>
