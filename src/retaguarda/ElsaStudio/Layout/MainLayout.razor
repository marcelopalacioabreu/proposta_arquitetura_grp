@inherits LayoutComponentBase

<div style="display:flex; flex-direction:column; height:100vh">
    <header style="padding:8px 16px; background:#f8f9fa; border-bottom:1px solid #dee2e6; flex-shrink:0">
        <div style="display:flex; justify-content:space-between; align-items:center">
            <h3 style="margin:0">Planejador de Fluxo</h3>
            <ProcessoReturnButton />
        </div>
    </header>
    <main style="flex:1; overflow:auto">
        @Body
    </main>
</div>

@code {
    [Inject] NavigationManager? Nav { get; set; }
    
    protected override void OnInitialized()
    {
        // Log context para debugging
        var uri = Nav?.Uri ?? "unknown";
        Console.WriteLine($"[ElsaStudio] Navigated to: {uri}");
    }
}
