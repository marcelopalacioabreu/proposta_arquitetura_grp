# .env.example - Variáveis de Ambiente
# Copiar para .env e preencher com valores específicos do ambiente

# ================================================
# AMBIENTE
# ================================================

# Ambiente de execução: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Development

# ================================================
# BANCO DE DADOS
# ================================================

# Provedor de banco: Postgres (padrão) ou MySql
Persistence__Provider=Postgres

# Connection string do Postgres
# Formato: Server=<host>;Port=<port>;Database=<database>;User Id=<usuario>;Password=<senha>;
Persistence__Connection=Server=localhost;Port=5432;Database=retaguarda;User Id=postgres;Password=senha123;

# OU Connection string do MySQL (se usar MySql)
# Persistence__Connection=Server=localhost;Port=3306;Database=retaguarda;User=root;Password=senha123;

# Timeout para conexões (segundos)
ConnectionTimeout=30

# Timeout para comandos (segundos)
CommandTimeout=300

# ================================================
# JWT / AUTENTICAÇÃO
# ================================================

# Chave JWT (256 bits = 32 bytes base64)
# Gerar: openssl rand -base64 32
Jwt__Key=PREENCHER-COM-CHAVE-SEGURA-32-BYTES

# Emissor do JWT (seu domínio/serviço)
Jwt__Issuer=https://localhost:5000

# Audiência do JWT (quem pode usar o token)
Jwt__Audience=https://localhost:5000

# Expiração do token em minutos
Jwt__ExpirationMinutes=60

# Expiração do refresh token em dias
Jwt__RefreshTokenExpirationDays=30

# ================================================
# COOKIES
# ================================================

# Nome do cookie de autenticação
Jwt__Cookie__Name=access_token

# SameSite: Strict, Lax (padrão), None
Jwt__Cookie__SameSite=Lax

# Marcar como Secure (HTTPS)
# Desenvolvimento: false, Produção: true
Jwt__Cookie__Secure=false

# ================================================
# PROXY / ELSA
# ================================================

# URL do servidor Elsa (interna, na rede do container/servidor)
Elsa__ServerUrl=http://localhost:6001

# URL da API Elsa (mesma ou diferente dependendo da rede)
Elsa__ApiUrl=http://localhost:6001

# ================================================
# CORS
# ================================================

# Domínios permitidos para CORS
# Múltiplos domínios separados por ponto-e-vírgula
Cors__AllowedOrigins=http://localhost:3000;http://localhost:5173;https://seu-dominio.com

# ================================================
# LOGGING
# ================================================

# Nível mínimo de log: Trace, Debug, Information, Warning, Error, Critical
Serilog__MinimumLevel=Information

# Nível por namespace específico
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft=Warning
Logging__LogLevel__Microsoft.EntityFrameworkCore=Warning

# ================================================
# RATE LIMITING
# ================================================

# Requisições por minuto (por IP)
RateLimit__RequestsPerMinute=100

# Aplicar rate limit por IP
RateLimit__PerIpAddress=true

# ================================================
# EMAIL (se configurado)
# ================================================

# Provedor SMTP
Email__SmtpServer=smtp.gmail.com
Email__SmtpPort=587
Email__SmtpUsername=seu-email@gmail.com
Email__SmtpPassword=sua-senha-app

# Remetente padrão
Email__FromAddress=noreply@dominio.com
Email__FromName=GRP System

# ================================================
# RECURSO - DATA PROTECTION KEYS
# ================================================

# Diretório onde ficam as chaves de proteção de dados
# Desenvolvimento: ./data-protection-keys
# Produção: /app/data-protection-keys ou /vault/keys
# ⚠️ CRÍTICO: Deve ser compartilhado entre API e Elsa
DataProtectionKeysPath=./data-protection-keys

# ================================================
# FEATURE FLAGS
# ================================================

# Habilitar novo endpoint experimental
Features__ExperimentalEndpoint=false

# Habilitar modo debug
Features__DebugMode=false

# ================================================
# INTEGRAÇÕES EXTERNAS
# ================================================

# Chave de API externa (exemplo: serviço de mapas)
ExternalApi__MapKey=sua-chave-aqui

# Chave de API de pagamento
ExternalApi__PaymentKey=sua-chave-pagamento

# ================================================
# NOTAS IMPORTANTES
# ================================================

# 1. DESENVOLVIMENTO:
#    - Persistence__Provider=Postgres
#    - Jwt__Issuer=https://localhost:5000
#    - Jwt__Cookie__Secure=false
#    - CORS__AllowedOrigins inclui localhost:3000, localhost:5173
#    - RateLimit__RequestsPerMinute=1000 (mais permissivo)
#
# 2. STAGING (Pré-produção):
#    - Tudo igual à PRODUÇÃO
#    - Certificado SSL staging
#    - Backup antes de testes
#
# 3. PRODUÇÃO:
#    - Jwt__Key: GERAR NOVA (não reutilizar dev!)
#    - Jwt__Issuer=https://seu-dominio.com
#    - Jwt__Audience=https://seu-dominio.com
#    - Jwt__Cookie__Secure=true
#    - Jwt__Cookie__SameSite=Lax (ou Strict se possível)
#    - CORS__AllowedOrigins=https://seu-dominio.com
#    - RateLimit__RequestsPerMinute=100 (mais restritivo)
#    - Serilog__MinimumLevel=Warning
#    - DataProtectionKeysPath=/app/data-protection-keys (volume Docker)

# 4. NUNCA commitar esse arquivo com valores preenchidos!
#    Git ignore já deve conter: .env (todos os arquivos .env)
